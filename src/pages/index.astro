---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import GameCard from '../components/GameCard.astro';
import DownloadIcon from '../components/DownloadIcon.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import { getDownloads } from '../lib/downloads';
import { formatSize } from '../lib/releases';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const featured = games.find((g) => g.data.status === 'playable');
if (!featured) throw new Error('The home page needs at least one playable game.');

const dl = await getDownloads(featured);
// Second line on each download button: "v1.1.3 · Installer · 664 MB". Parts the build couldn't fetch are left out.
const subline = (...parts: (string | number | undefined)[]) =>
  parts
    .filter((p) => p !== undefined)
    .map((p) => (typeof p === 'number' ? formatSize(p) : p))
    .join(' · ');
const { hero, heroAlt, highlights, screenshots, requirements } = featured.data;
const gameUrl = `/games/${featured.id}/`;
const og = hero ? await getImage({ src: hero, width: 1200, format: 'jpg' }) : undefined;
---

<Base overlayHeader image={og?.src}>
  <section class="hero">
    {
      hero && (
        <Image
          src={hero}
          alt={heroAlt ?? ''}
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      )
    }
    <div class="hero-shade" aria-hidden="true"></div>
    <Header overlay />
    <div class="wrap hero-copy">
      {
        dl?.release && (
          <a class="badge" href={dl.release.url}>
            {dl.release.tag} out now for Windows{dl.linux && <> · <span class="nowrap">Linux in beta</span></>}
          </a>
        )
      }
      <h1 class="display">
        {featured.data.title},<br /><span>now on PC.</span>
      </h1>
      <p class="intro">
        A native PC port of the 2002 GameCube classic. The original code is recompiled ahead of time, so there's no
        emulator in between: just Mystic Manor in 4K, widescreen and 60 fps.
      </p>
      <div class="actions">
        {
          dl?.windows && dl.zip && (
            <div class="split" role="group" aria-label="Download for Windows">
              <a class="split-main" href={dl.windows.url}>
                <DownloadIcon />
                <span class="btn-text">
                  <span>
                    <span class="wide">Download for </span>Windows
                  </span>
                  <small>
                    {dl.release && <span class="wide">{dl.release.tag} · </span>}
                    {subline('Installer', dl.windows.size)}
                  </small>
                </span>
              </a>
              <a class="split-alt" href={dl.zip.url} aria-label={subline('Portable zip', dl.zip.size)}>
                <span class="btn-text">
                  <span>Zip</span>
                  <small>
                    {dl.zip.size ? (
                      <>
                        <span class="wide">Portable · </span>
                        {formatSize(dl.zip.size)}
                      </>
                    ) : (
                      'Portable'
                    )}
                  </small>
                </span>
              </a>
            </div>
          )
        }
        {
          dl?.windows && !dl.zip && (
            <a class="btn btn--primary" href={dl.windows.url}>
              <DownloadIcon /> Download for Windows
            </a>
          )
        }
        {
          dl?.linux && dl.tarball && (
            <div class="split split--linux" role="group" aria-label="Download for Linux">
              <a class="split-main" href={dl.linux.url}>
                <DownloadIcon />
                <span class="btn-text">
                  <span>Linux AppImage</span>
                  <small>{subline('Beta', dl.linux.size)}</small>
                </span>
              </a>
              <a class="split-alt" href={dl.tarball.url} aria-label={subline('Portable tarball', dl.tarball.size)}>
                <span class="btn-text">
                  <span>Tarball</span>
                  <small>
                    {dl.tarball.size ? (
                      <>
                        <span class="wide">Portable · </span>
                        {formatSize(dl.tarball.size)}
                      </>
                    ) : (
                      'Portable'
                    )}
                  </small>
                </span>
              </a>
            </div>
          )
        }
        {
          dl?.linux && !dl.tarball && (
            <a class="btn btn--alt" href={dl.linux.url}>
              <DownloadIcon />
              <span class="btn-text">
                <span>Linux AppImage</span>
                <small>{subline('Beta', dl.linux.size)}</small>
              </span>
            </a>
          )
        }
        {
          dl?.recompLauncher && (
            <a class="rl" href={dl.recompLauncher}>
              <img src="/badges/recomplauncher-dark.svg" alt="Get it on RecompLauncher" width="313" height="56" />
            </a>
          )
        }
      </div>
      {
        requirements && (
          <p class="req">
            You need your own disc image: <strong>{requirements}</strong>. No game data is included.{' '}
            <a href={`${gameUrl}#common-questions`}>Common questions</a>
          </p>
        )
      }
    </div>
  </section>

  {
    highlights.length > 0 && (
      <section class="strip" aria-label="Highlights">
        <ul class="wrap strip-grid">
          {highlights.map((h) => (
            <li>
              <span class="display">{h.value}</span>
              <span>{h.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    screenshots.length > 0 && (
      <section class="wrap block gallery">
        <div class="block-head">
          <h2 class="display section-title">Mystic Manor, remastered</h2>
          <p class="lead">
            Every screen is the real port running on PC. The Creeper's window animation from the Xbox edition is back in
            the courtyard, too.
          </p>
        </div>
        <ScreenshotGallery shots={screenshots.slice(0, 3)} />
        {
          screenshots.length > 3 && (
            <p class="lead more-line">
              <a href={`${gameUrl}#screenshots`}>All {screenshots.length} screenshots →</a>
            </p>
          )
        }
      </section>
    )
  }

  <section class="wrap block">
    <h2 class="display section-title">Playing in three steps</h2>
    <ol class="steps">
      <li>
        <span class="display num" aria-hidden="true">1</span>
        <strong>Download the installer</strong>
        <span>
          {dl?.windows?.file ?? 'The installer'} installs for your user, with no admin rights. Prefer one folder? Grab the
          zip.
        </span>
        <span class="note">
          Windows may warn that the setup is from an unknown publisher, because it isn't code-signed. Choose{' '}
          <b>More info</b>, then <b>Run anyway</b>.
        </span>
      </li>
      <li>
        <span class="display num" aria-hidden="true">2</span>
        <strong>Point it at your disc</strong>
        <span>The launcher asks for your own GameCube image the first time. Nothing from the game ships with us.</span>
      </li>
      <li>
        <span class="display num" aria-hidden="true">3</span>
        <strong>Press Play</strong>
        <span>Updates arrive through the launcher and keep your saves and settings.</span>
      </li>
    </ol>
    <p class="lead more-line">
      Linux, the zip, file locations and more: <a href={gameUrl}>full install guide</a>. Stuck on something?{' '}
      <a href={`${gameUrl}#common-questions`}>Common questions</a>.
    </p>
  </section>

  <section class="wrap block games" id="games">
    <h2 class="display section-title">Our ports</h2>
    <div class="cards">
      {games.map((g) => <GameCard game={g} />)}
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(760px, 92svh);
    display: flex;
    flex-direction: column;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(13, 16, 41, 0.75) 0%,
      rgba(13, 16, 41, 0.15) 30%,
      rgba(13, 16, 41, 0.6) 62%,
      var(--night) 100%
    );
  }
  .hero-copy {
    position: relative;
    margin-top: auto;
    width: 100%;
    padding-top: 120px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .badge {
    align-self: flex-start;
    background: rgba(155, 231, 185, 0.14);
    color: var(--ghost);
    border: 1px solid rgba(155, 231, 185, 0.4);
    border-radius: 999px;
    padding: 4px 14px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .badge:hover {
    color: var(--moon);
  }
  .nowrap {
    white-space: nowrap;
  }
  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.95;
    text-shadow:
      0 4px 0 var(--night),
      0 10px 40px rgba(0, 0, 0, 0.6);
  }
  h1 span {
    color: var(--lantern);
  }
  .intro {
    margin: 0;
    max-width: 620px;
    font-size: 1.25rem;
    color: var(--moon-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }
  .btn-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .btn-text small {
    font-size: 0.8125rem;
    font-weight: 600;
    opacity: 0.8;
  }

  /* Windows split button: installer on the left two-thirds, portable zip on the right third. The halves
     are cut on a slant; the gap between them shows the container's darker amber as a diagonal divider. */
  .split {
    --slant: 18px;
    --cut: 3px;
    display: inline-grid;
    grid-template-columns: 2fr 1fr;
    border-radius: 14px;
    background: var(--lantern-shadow);
    box-shadow: 0 6px 0 var(--lantern-shadow);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .split:has(a:hover) {
    transform: translateY(2px);
    box-shadow: 0 4px 0 var(--lantern-shadow);
  }
  .split:has(a:focus-visible) {
    outline: 3px solid var(--moon);
    outline-offset: 3px;
  }
  .split a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding-block: 12px;
    color: var(--lantern-ink);
    font-weight: 700;
    font-size: 1.125rem;
    transition: background 0.15s ease;
  }
  /* The clip-path would cut off a normal focus ring, so the group gets the ring (above) and the
     focused half is marked by underlining its label. */
  .split a:focus-visible {
    outline: none;
  }
  .split a:focus-visible .btn-text > span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .split-main {
    padding-left: 26px;
    padding-right: calc(22px + var(--slant));
    background: var(--lantern);
    border-radius: 14px 0 0 14px;
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
  }
  .split-main:hover {
    background: var(--lantern-hover);
  }
  .split-alt {
    margin-left: calc(var(--cut) - var(--slant));
    padding-left: calc(var(--slant) + 14px);
    padding-right: 22px;
    background: var(--lantern-deep);
    border-radius: 0 14px 14px 0;
    clip-path: polygon(var(--slant) 0, 100% 0, 100% 100%, 0 100%);
  }
  .split-alt:hover {
    background: var(--lantern-deep-hover);
  }
  .split :global(svg) {
    flex: none;
  }
  /* Linux: the same split in the ghost-green outline style of .btn--alt. Solid colours (the translucent
     .btn--alt fills over --night), so the container's lighter green shows only in the gap and the 2px rim. */
  .split--linux {
    padding: 2px;
    background: #5b8678;
    box-shadow: none;
  }
  .split--linux:has(a:hover) {
    box-shadow: none;
  }
  .split--linux a {
    color: var(--ghost);
  }
  .split--linux a:hover {
    color: var(--moon);
  }
  .split--linux .split-main {
    background: #243240;
    border-radius: 12px 0 0 12px;
  }
  .split--linux .split-main:hover {
    background: #32484e;
  }
  .split--linux .split-alt {
    background: #1b2537;
    border-radius: 0 12px 12px 0;
  }
  .split--linux .split-alt:hover {
    background: #293b46;
  }
  /* Phones: fill the row, shorten the labels (the badge above already shows the version), and let
     them wrap rather than overflow on the narrowest screens. */
  @media (max-width: 520px) {
    .split {
      --slant: 14px;
      display: grid;
      width: 100%;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
    .split a {
      gap: 8px;
      font-size: 1rem;
    }
    .split-main {
      padding-left: 16px;
      padding-right: calc(14px + var(--slant));
    }
    .split-alt {
      padding-left: calc(var(--slant) + 10px);
      padding-right: 14px;
    }
    .split .wide {
      display: none;
    }
  }
  /* RecompLauncher's own badge, self-hosted (the CSP only allows our own images). Kept at its native 56px,
     a little shorter than the buttons, so all three fit on one row on a laptop screen. */
  .rl {
    display: block;
    align-self: center;
    border-radius: 12px;
  }
  .rl img {
    display: block;
    height: 56px;
    width: auto;
  }
  .rl:hover img {
    filter: brightness(1.15);
  }
  .rl:focus-visible {
    outline: 3px solid var(--moon);
    outline-offset: 3px;
  }
  .req {
    margin: 6px 0 0;
    max-width: 620px;
    padding-left: 14px;
    border-left: 3px solid var(--lantern);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--moon-soft);
  }
  .req strong {
    color: var(--moon);
  }
  .req a {
    color: var(--lantern);
    font-weight: 600;
    white-space: nowrap;
  }
  .req a:hover {
    text-decoration: underline;
  }

  /* Highlights strip */
  .strip {
    border-block: 1px solid var(--line);
    background: var(--night-band);
  }
  .strip-grid {
    list-style: none;
    margin-block: 0;
    margin-inline: auto;
    padding-block: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 24px;
  }
  .strip-grid li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .strip-grid .display {
    font-size: 2.125rem;
    color: var(--lantern);
    line-height: 1.1;
  }

  /* Sections */
  .block {
    padding-block: 64px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .gallery {
    padding-top: 96px;
  }
  .games {
    padding-bottom: 96px;
  }
  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }
  .block-head .lead {
    max-width: 420px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }
  .steps li {
    background: var(--panel);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--muted);
  }
  .steps strong {
    color: var(--moon);
    font-size: 1.25rem;
  }
  .steps .note {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px dashed var(--line-dashed);
    font-size: 0.9375rem;
  }
  .steps .note b {
    color: var(--moon);
  }
  .num {
    font-size: 2.75rem;
    color: var(--lantern);
  }
  .more-line a {
    color: var(--lantern);
    font-weight: 600;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
  }
</style>
