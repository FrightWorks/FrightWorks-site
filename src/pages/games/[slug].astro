---
import { Image, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DownloadIcon from '../../components/DownloadIcon.astro';
import { getDownloads } from '../../lib/downloads';
import { formatDate, formatSize } from '../../lib/releases';
import { statusChip } from '../../lib/status';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { title, status, original, summary, hero, heroAlt, cover, coverAlt, boxart, screenshots, requirements } = game.data;
const playable = status === 'playable';
const { Content, headings } = await render(game);
// "On this page" list beside the text on wide screens; only worth showing for a page with a few sections.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
const dl = playable ? await getDownloads(game) : null;
// Full-width banner: the hero, else the cover if it's sharp enough to stretch across the page.
const banner = hero ?? (cover && cover.width >= 1280 ? cover : undefined);
const bannerAlt = hero ? heroAlt : coverAlt;
const ogSource = banner ?? cover ?? boxart;
const og = ogSource ? await getImage({ src: ogSource, width: Math.min(1200, ogSource.width), format: 'jpg' }) : undefined;

// A game that isn't out yet points visitors at the one they can play today.
const playNow = playable
  ? undefined
  : (await getCollection('games'))
      .filter((g) => g.data.status === 'playable')
      .sort((a, b) => a.data.order - b.data.order)[0];
---

<Base title={title} description={summary} image={og?.src}>
  <section class:list={['banner', { plain: !banner }]}>
    {
      banner && (
        <Image
          src={banner}
          alt={bannerAlt ?? ''}
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="banner-img"
        />
      )
    }
    <div class="banner-shade" aria-hidden="true"></div>
    <div class:list={['wrap', 'banner-copy', { 'has-box': !banner && boxart }]}>
      {!banner && boxart && (
        <Image src={boxart} alt={`${title} GameCube case`} widths={[240, 480]} sizes="220px" loading="eager" class="page-box" />
      )}
      <div class="chips">
        <span class={`chip ${statusChip[status].className}`}>{statusChip[status].label}</span>
        {original && <span class="chip">{original}</span>}
      </div>
      <h1 class="display">{title}</h1>
      <p class="intro">{summary}</p>
    </div>
  </section>

  {
    dl && (
      <section class="wrap" id="download">
        <div class="download">
          <div class="dl-head">
            <h2 class="display">Download</h2>
            {dl.release ? (
              <p class="lead">
                <a href={dl.release.url}>{dl.release.tag}</a>, released {formatDate(dl.release.publishedAt)}
              </p>
            ) : (
              <p class="lead">
                <a href={dl.releasesUrl}>Latest release on GitHub</a>
              </p>
            )}
          </div>
          <ul class="files">
            {dl.windows && (
              <li>
                <div>
                  <p class="file">
                    <code>{dl.windows.file}</code>
                    {dl.windows.size && <span class="size">{formatSize(dl.windows.size)}</span>}
                  </p>
                  <span>Windows installer. No admin rights, updates itself.</span>
                </div>
                <a class="btn btn--primary" href={dl.windows.url}>
                  <DownloadIcon /> Windows
                </a>
              </li>
            )}
            {dl.zip && (
              <li>
                <div>
                  <p class="file">
                    <code>{dl.zip.file}</code>
                    {dl.zip.size && <span class="size">{formatSize(dl.zip.size)}</span>}
                  </p>
                  <span>Portable zip. Everything in one folder.</span>
                </div>
                <a class="btn btn--ghost" href={dl.zip.url}>
                  Zip
                </a>
              </li>
            )}
            {dl.linux && (
              <li>
                <div>
                  <p class="file">
                    <code>{dl.linux.file}</code>
                    {dl.linux.size && <span class="size">{formatSize(dl.linux.size)}</span>}
                  </p>
                  <span>Linux x86_64, beta. Needs Vulkan and FUSE.</span>
                </div>
                <a class="btn btn--alt" href={dl.linux.url}>
                  <DownloadIcon /> Linux (beta)
                </a>
              </li>
            )}
          </ul>
          {requirements && (
            <p class="req">
              You need your own disc: <strong>{requirements}</strong>. No game data is included.
            </p>
          )}
        </div>
      </section>
    )
  }

  {
    screenshots.length > 0 && (
      <section class="wrap shots-wrap">
        <h2 class="display section-title">Screenshots</h2>
        <div class="shots">
          {screenshots.map((s) => (
            <figure>
              <Image src={s.src} alt={s.caption} widths={[480, 800, 1200]} sizes="(min-width: 900px) 400px, 100vw" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }
  <section class="wrap body">
    <div class:list={['body-grid', { 'has-toc': showToc }]}>
      <article class="prose">
        <Content />
      </article>
      {
        showToc && (
          <nav class="toc" aria-label="On this page">
            <p>On this page</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </section>


  {
    playNow && (
      <section class="wrap meanwhile-wrap">
        <div class="meanwhile">
          <div>
            <h2 class="display">While you wait</h2>
            <p class="lead">
              <strong>{playNow.data.title}</strong> is playable now. {playNow.data.summary}
            </p>
          </div>
          <a class="btn btn--primary" href={`/games/${playNow.id}/`}>
            Get {playNow.data.title}
          </a>
        </div>
      </section>
    )
  }

</Base>

<script>
  // Highlight the "On this page" entry for the section being read: the last heading that has
  // scrolled past 40% of the window's height, or the last one once the page is scrolled to the end.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const sections = links
    .map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
    .filter((s): s is { link: HTMLAnchorElement; heading: HTMLElement } => s.heading !== null);

  if (sections.length > 0) {
    let queued = false;
    const update = () => {
      queued = false;
      const line = window.innerHeight * 0.4;
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let current = atEnd ? sections[sections.length - 1] : undefined;
      if (!current) {
        for (const s of sections) {
          if (s.heading.getBoundingClientRect().top <= line) current = s;
          else break;
        }
      }
      for (const s of sections) {
        if (s === current) s.link.setAttribute('aria-current', 'location');
        else s.link.removeAttribute('aria-current');
      }
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }
</script>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    background: var(--panel-dim);
  }
  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 16, 41, 0.25) 0%, rgba(13, 16, 41, 0.6) 55%, var(--night) 100%);
  }
  .banner-copy {
    position: relative;
    margin-top: auto;
    width: 100%;
    padding-top: 96px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* No artwork yet: don't reserve the image's height. */
  .banner.plain {
    min-height: 0;
    background: none;
  }
  .banner.plain .banner-shade {
    display: none;
  }
  .banner.plain .banner-copy {
    padding-top: 64px;
    padding-bottom: 16px;
  }
  /* No banner image: show the GameCube case beside the title instead. */
  .page-box {
    width: 140px;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }
  @media (min-width: 760px) {
    .banner-copy.has-box {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 48px;
      align-items: start;
    }
    .banner-copy.has-box > :not(.page-box) {
      grid-column: 1;
    }
    .page-box {
      grid-column: 2;
      grid-row: 1 / span 3;
      width: 220px;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6vw, 5rem);
    text-shadow:
      0 4px 0 var(--night),
      0 10px 40px rgba(0, 0, 0, 0.6);
  }
  .intro {
    margin: 0;
    max-width: 640px;
    font-size: 1.1875rem;
    color: var(--moon-soft);
  }

  .download {
    background: var(--panel);
    border-radius: 24px;
    padding: clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    scroll-margin-top: 24px;
  }
  .dl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .dl-head h2 {
    margin: 0;
    font-size: 2.25rem;
  }
  .dl-head a {
    color: var(--lantern);
    font-weight: 600;
  }
  .files {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .files li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }
  .files li > div {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .files .file {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
  }
  .files .size {
    font-weight: 600;
    white-space: nowrap;
  }
  .files code {
    font-family: var(--font-mono);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .files span {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .files .btn {
    font-size: 1rem;
    padding: 12px 22px;
  }
  .req {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .req strong {
    color: var(--moon);
  }

  .body {
    padding-block: 56px 80px;
  }
  .toc {
    display: none;
  }
  /* Wide screens: the text keeps its reading width and the free column on the right holds a list of
     the page's sections that stays in view while scrolling. */
  @media (min-width: 1080px) {
    .body-grid.has-toc {
      display: grid;
      grid-template-columns: minmax(0, 70ch) 240px;
      justify-content: space-between;
      gap: 64px;
    }
    .toc {
      display: block;
      position: sticky;
      top: 32px;
      align-self: start;
      margin-top: 2.5rem;
      padding-left: 20px;
      border-left: 2px solid var(--line);
    }
  }
  .toc p {
    margin: 0 0 10px;
    color: var(--faint);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .toc a {
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .toc a:hover {
    color: var(--lantern);
  }
  .toc li {
    position: relative;
  }
  /* The current section: amber text and an amber bar over the list's left rule. */
  .toc a[aria-current] {
    color: var(--lantern);
  }
  .toc a[aria-current]::before {
    content: '';
    position: absolute;
    left: -22px;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--lantern);
  }

  .meanwhile-wrap {
    padding-bottom: 96px;
  }
  .meanwhile {
    background: var(--panel);
    border-radius: 24px;
    padding: clamp(24px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .meanwhile > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1 1 320px;
    max-width: 640px;
  }
  .meanwhile h2 {
    margin: 0;
    font-size: 2.25rem;
  }
  .meanwhile strong {
    color: var(--moon);
  }

  .shots-wrap {
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  figure :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 18px;
    border: 3px solid var(--line);
  }
  figcaption {
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
