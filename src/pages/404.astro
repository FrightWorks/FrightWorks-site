---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap lost">
    <p class="display code" aria-hidden="true">404</p>
    <h1 class="display">Ruh-roh. Nothing here.</h1>
    <p class="lead">This page vanished like a ghost at midnight, or it never existed.</p>
    <a class="btn btn--primary" href="/">Back to the manor</a>
  </section>
</Base>

<style>
  .lost {
    padding-block: 96px 128px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .code {
    margin: 0;
    font-size: clamp(5rem, 16vw, 10rem);
    color: var(--lantern);
    line-height: 0.9;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
  }
</style>
