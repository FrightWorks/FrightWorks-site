---
// Download stats for Night of 100 Frights. The numbers come from /stats.json, which the FrightWorks web server
// regenerates every 5 minutes (see src/lib/stats.ts). The build renders them once as the starting point (and for
// visitors without JavaScript); the script below loads /stats.json when the page opens and every 5 minutes while
// it stays open, and redraws with src/lib/stats-view.ts, the same code the build uses. The only other
// interactivity is CSS tooltips on the chart bars, and every value in them is also in the tables.
import Base from '../layouts/Base.astro';
import { getStats, renderStats, renderUnavailable } from '../lib/stats';

const stats = await getStats();
---

<Base title="Download stats" description="How often the FrightWorks port of Night of 100 Frights has been downloaded, per version and per day.">
  <section class="wrap stats-page">
    <h1 class="display">Download stats</h1>
    <div data-stats-live data-generated={stats?.generated ?? ''} set:html={stats ? renderStats(stats) : renderUnavailable()} />

    <section class="card meaning" aria-labelledby="meaning">
      <h2 id="meaning" class="display">What these numbers mean</h2>
      <p>
        <strong>Downloads</strong> are requests for the game: the Windows installer plus the Windows zip, or the
        Linux AppImage plus the Linux tarball. GitHub counts requests, not people, so retries, scanners and someone
        grabbing both the installer and the zip all add up. Treat it as an upper bound on new players.
      </p>
      <p>
        <strong>Update files</strong> are the in-app updater fetching a version's update packages (full or delta).
        One update can fetch more than one file, so this isn't the number of people who updated.
      </p>
      <p>
        <strong>Update checks</strong> are installed copies looking for an update (the busiest feed file), a rough
        sign of installs in use, not unique users. The same installs can show up under several versions, so don't
        add update checks across versions.
      </p>
    </section>
  </section>
</Base>

<script>
  import { renderStats, usable } from '../lib/stats-view';

  const root = document.querySelector<HTMLElement>('[data-stats-live]');
  const REFRESH_MS = 5 * 60 * 1000;

  async function refresh() {
    if (!root || document.hidden) return;
    try {
      const res = await fetch('/stats.json', { cache: 'no-cache' });
      if (!res.ok) return;
      const data: unknown = await res.json();
      if (!usable(data) || data.generated === root.dataset.generated) return;
      // Keep the versions the reader opened, and the keyboard focus out of the way of the redraw.
      const open = root.dataset.generated
        ? new Set([...root.querySelectorAll<HTMLDetailsElement>('details[open]')].map((d) => d.dataset.tag ?? ''))
        : undefined;
      if (root.contains(document.activeElement)) return;
      root.innerHTML = renderStats(data, open);
      root.dataset.generated = data.generated;
    } catch {
      // Offline or a bad answer: keep what's on the page.
    }
  }

  refresh();
  setInterval(refresh, REFRESH_MS);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
</script>

<style is:global>
  .stats-page {
    padding-block: 56px 96px;
  }
  .stats-page h1 {
    margin: 0 0 16px;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    color: var(--lantern);
  }
  .stats-page .intro {
    max-width: 70ch;
  }
  .stats-page .intro strong {
    color: var(--moon);
  }
  .stats-page .intro a,
  .stats-page .links a {
    color: var(--lantern);
  }
  .stats-page .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 12px 0 32px;
    font-weight: 600;
  }
  .stats-page .links a:hover {
    text-decoration: underline;
  }

  /* Stat tiles */
  .stats-page .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .stats-page .tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 20px 22px;
    background: var(--panel);
    border-radius: var(--radius);
  }
  .stats-page .tile .k {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .stats-page .tile .v {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .stats-page .tile .d {
    color: var(--faint);
    font-size: 0.875rem;
  }
  .stats-page .tile .up {
    color: var(--ghost);
    font-weight: 600;
  }

  /* Cards */
  .stats-page .card {
    background: var(--panel);
    border-radius: var(--radius);
    padding: 28px clamp(20px, 3vw, 32px);
    margin-bottom: 24px;
  }
  .stats-page .card h2 {
    margin: 0 0 6px;
    font-size: clamp(1.625rem, 3vw, 2rem);
  }
  .stats-page .note {
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 75ch;
  }
  .stats-page .key {
    display: inline-block;
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .stats-page .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 14px;
    color: var(--moon-soft);
    font-size: 0.9375rem;
  }
  .stats-page .legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Tooltips on chart bars: hover or keyboard focus. The same numbers are in the tables. */
  .stats-page .hbar i,
  .stats-page .track i {
    position: relative;
    display: block;
    font-style: normal;
    outline-offset: 2px;
    transition: filter 0.12s ease;
  }
  .stats-page .hbar i:hover,
  .stats-page .hbar i:focus-visible,
  .stats-page .track i:hover,
  .stats-page .track i:focus-visible {
    filter: brightness(1.18);
  }
  .stats-page .hbar i:hover::after,
  .stats-page .hbar i:focus-visible::after,
  .stats-page .track i:hover::after,
  .stats-page .track i:focus-visible::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    z-index: 5;
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--moon);
    color: var(--night);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Downloads per version: horizontal stacked bars */
  .stats-page .hbars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stats-page .hrow {
    display: grid;
    grid-template-columns: 5rem 1fr 4rem;
    gap: 12px;
    align-items: center;
    font-size: 0.9375rem;
  }
  .stats-page .tag {
    font-weight: 600;
  }
  .stats-page .hbar {
    display: flex;
    gap: 2px;
    height: 20px;
  }
  .stats-page .hbar i {
    height: 100%;
    min-width: 3px;
  }
  .stats-page .hbar i:last-child {
    border-radius: 0 4px 4px 0;
  }
  .stats-page .n {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* New downloads per day: columns */
  .stats-page .cols {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 4px;
    border-bottom: 1px solid var(--line);
    padding-top: 8px;
  }
  .stats-page .col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  /* Release markers: tag labels in two rows above the columns, a dashed line down to the axis. */
  .stats-page .cols.has-rel {
    padding-top: 40px;
  }
  .stats-page .rtag {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--lantern);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .stats-page .rtag.start {
    left: calc(50% - 1px);
    transform: none;
  }
  .stats-page .rtag.end {
    left: auto;
    right: calc(50% - 1px);
    transform: none;
  }
  .stats-page .r0 .rtag {
    top: -34px;
  }
  .stats-page .r1 .rtag {
    top: -18px;
  }
  .stats-page .rel .track::before {
    content: '';
    position: absolute;
    left: calc(50% - 1px);
    bottom: 0;
    border-left: 2px dashed var(--lantern);
    opacity: 0.75;
  }
  .stats-page .r0 .track::before {
    top: -21px;
  }
  .stats-page .r1 .track::before {
    top: -5px;
  }
  /* Positioned with a panel background so a release line passes behind the value, not through it. */
  .stats-page .val {
    position: relative;
    padding: 0 3px;
    background: var(--panel);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--moon-soft);
    font-variant-numeric: tabular-nums;
  }
  /* Value on the cap of each column; the tallest column is 140px, leaving room for its label. */
  .stats-page .track {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    width: 100%;
    height: 170px;
  }
  .stats-page .track i {
    width: min(100%, 24px);
    min-height: 2px;
    border-radius: 4px 4px 0 0;
    background: var(--series-all);
  }
  .stats-page .track i::after {
    left: 50%;
    transform: translateX(-50%);
  }
  .stats-page .date {
    position: relative;
    top: 8px;
    margin-bottom: 8px;
    color: var(--faint);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  /* Details per version */
  .stats-page details {
    border-top: 1px solid var(--line);
  }
  .stats-page details:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .stats-page summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding: 14px 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    transition: color 0.15s ease;
  }
  .stats-page summary::-webkit-details-marker {
    display: none;
  }
  .stats-page summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--lantern);
  }
  .stats-page details[open] > summary::after {
    content: '\2212';
  }
  .stats-page summary:hover {
    color: var(--lantern);
  }
  .stats-page summary small {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .stats-page .tbl {
    overflow-x: auto;
    margin-bottom: 16px;
  }
  .stats-page table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .stats-page th,
  .stats-page td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .stats-page th {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .stats-page th.n,
  .stats-page td.n {
    text-align: right;
    white-space: nowrap;
  }
  .stats-page td small {
    display: block;
    color: var(--faint);
    font-size: 0.8125rem;
  }
  .stats-page .fn {
    min-width: 10rem;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .stats-page .desc {
    min-width: 14rem;
    color: var(--moon-soft);
  }

  .stats-page .meaning p {
    margin: 0 0 12px;
    color: var(--moon-soft);
    max-width: 75ch;
  }
  .stats-page .meaning p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 520px) {
    .stats-page .tile {
      padding: 16px 18px;
    }
    .stats-page .tile .v {
      font-size: 1.875rem;
    }
    .stats-page .hrow {
      grid-template-columns: 3.75rem 1fr 3rem;
      gap: 8px;
    }
    .stats-page .val {
      font-size: 0.6875rem;
    }
    .stats-page .date {
      font-size: 0.6875rem;
    }
  }
</style>
