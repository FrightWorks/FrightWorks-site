---
// Screenshot grid with a full-size viewer. Each shot is shown whole (letterboxed in a 16:9 frame,
// whatever its own aspect ratio) and links to the full-size image; with JavaScript the link opens
// the viewer instead, which steps through the gallery with the arrow keys or buttons.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shots: { src: ImageMetadata; caption: string }[];
}

const { shots } = Astro.props;
const full = await Promise.all(shots.map((s) => getImage({ src: s.src, width: s.src.width, format: 'webp' })));
---

<div class="gallery">
  <div class="shots">
    {
      shots.map((s, i) => (
        <figure>
          <a class="shot" href={full[i].src} data-caption={s.caption}>
            <Image src={s.src} alt={s.caption} widths={[480, 800, 1200]} sizes="(min-width: 900px) 400px, 100vw" />
          </a>
          <figcaption>{s.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <dialog class="viewer" aria-label="Screenshot viewer">
    <div class="viewer-frame">
      <img class="viewer-img" alt="" />
      <div class="viewer-bar">
        {shots.length > 1 && <button type="button" class="viewer-prev" aria-label="Previous screenshot">‹</button>}
        <p class="viewer-caption"></p>
        {shots.length > 1 && <button type="button" class="viewer-next" aria-label="Next screenshot">›</button>}
      </div>
    </div>
    <button type="button" class="viewer-close" aria-label="Close" autofocus>×</button>
  </dialog>
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('.gallery')) {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a.shot')];
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog.viewer')!;
    const img = dialog.querySelector<HTMLImageElement>('.viewer-img')!;
    const caption = dialog.querySelector<HTMLElement>('.viewer-caption')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.href;
      img.alt = link.dataset.caption ?? '';
      caption.textContent = link.dataset.caption ?? '';
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('.viewer-prev')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.viewer-next')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.viewer-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (links.length < 2) return;
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // A click on the dimmed area around the image closes the viewer.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('viewer-frame')) dialog.close();
    });
    // Back to the thumbnail that opened it, so keyboard users keep their place.
    dialog.addEventListener('close', () => links[index].focus());
  }
</script>

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .shot {
    display: block;
    border-radius: 18px;
    border: 3px solid var(--line);
    background: var(--night-deep);
    overflow: hidden;
    cursor: zoom-in;
    transition: border-color 0.15s ease;
  }
  .shot:hover {
    border-color: var(--lantern);
  }
  .shot :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }
  figcaption {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* Viewer */
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--moon);
  }
  .viewer::backdrop {
    background: rgba(9, 11, 31, 0.96);
  }
  .viewer-frame {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 56px 16px 24px;
  }
  /* The image fills a fixed area (letterboxed inside it), so the buttons below don't move when
     stepping between shots of different aspect ratios. */
  .viewer-img {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    max-width: 1920px;
    object-fit: contain;
  }
  .viewer-bar {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .viewer-caption {
    margin: 0;
    width: min(60vw, 28rem);
    text-align: center;
    color: var(--moon-soft);
  }
  .viewer button {
    flex: none;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 2px solid var(--line-dashed);
    background: var(--panel);
    color: var(--moon);
    font: 700 1.75rem/1 var(--font-body);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .viewer button:hover {
    border-color: var(--lantern);
    color: var(--lantern);
  }
  .viewer-close {
    position: absolute;
    top: 12px;
    right: 12px;
  }
  :global(html:has(dialog.viewer[open])) {
    overflow: hidden;
  }
</style>
