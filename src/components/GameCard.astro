---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLatestRelease } from '../lib/releases';

interface Props {
  game: CollectionEntry<'games'>;
}
const { game } = Astro.props;
const { title, status, original, summary, cover, coverAlt, repo } = game.data;
const playable = status === 'playable';
const release = playable && repo ? await getLatestRelease(repo) : null;
const href = `/games/${game.id}/`;
---

<article class:list={['card', { soon: !playable }]}>
  {
    cover && (
      <Image src={cover} alt={coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 800px) 600px, 100vw" class="cover" />
    )
  }
  <div class="body">
    <div class="chips">
      {playable ? <span class="chip chip--playable">Playable</span> : <span class="chip chip--soon">Coming soon</span>}
      {original && <span class="chip">{original}</span>}
      {release && <span class="chip">{release.tag}</span>}
    </div>
    <h3 class="display">
      <!-- The link's ::after covers the card, so the whole card is one click target. -->
      <a href={href} class="card-link">{title}</a>
    </h3>
    <p class="lead">{summary}</p>
    <span class="more" aria-hidden="true">
      {playable ? 'Download and install guide' : 'About this port'} →
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--panel);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: background 0.15s ease;
  }
  .card:hover {
    background: var(--chip);
  }
  .card.soon {
    background: var(--panel-dim);
    border: 2px dashed var(--line-dashed);
    justify-content: center;
    min-height: 360px;
  }
  .card.soon:hover {
    background: var(--panel);
  }
  .cover {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }
  .body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .soon .body {
    padding: 36px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  h3 {
    margin: 0;
    font-size: 2rem;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 22px;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card-link:focus-visible::after {
    outline: 3px solid var(--lantern);
    outline-offset: -3px;
  }
  .more {
    margin-top: 6px;
    color: var(--lantern);
    font-weight: 700;
  }
  .soon .more {
    color: var(--moon);
    font-weight: 600;
  }
  .soon:hover .more {
    color: var(--lantern);
  }
</style>
