---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLatestRelease } from '../lib/releases';
import { statusChip } from '../lib/status';

interface Props {
  game: CollectionEntry<'games'>;
}
const { game } = Astro.props;
const { title, status, original, summary, cover, coverAlt, boxart, repo } = game.data;
const playable = status === 'playable';
const release = playable && repo ? await getLatestRelease(repo) : null;
const href = `/games/${game.id}/`;
---

<article class:list={['card', { soon: !playable }]}>
  {
    (cover || boxart) && (
      <div class="art">
        {boxart && (
          <Image src={boxart} alt={`${title} GameCube case`} widths={[240, 480]} sizes="(min-width: 800px) 200px, 35vw" class="box" />
        )}
        {cover && (
          <Image src={cover} alt={coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 800px) 400px, 70vw" class="cover" />
        )}
      </div>
    )
  }
  <div class="body">
    <div class="chips">
      <span class={`chip ${statusChip[status].className}`}>{statusChip[status].label}</span>
      {original && <span class="chip">{original}</span>}
      {release && <span class="chip">{release.tag}</span>}
    </div>
    <h3 class="display">
      <!-- The link's ::after covers the card, so the whole card is one click target. -->
      <a href={href} class="card-link">{title}</a>
    </h3>
    <p class="lead">{summary}</p>
    <span class="more" aria-hidden="true">
      {playable ? 'Download and install guide' : 'About this port'} →
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--panel);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      background 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  /* Hover lifts the card slightly. The background stays darker than --chip so the chips inside
     (platform, version) keep their pill shape. */
  .card:hover {
    background: var(--panel-hover);
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35);
  }
  .card.soon {
    background: var(--panel-dim);
    border: 2px dashed var(--line-dashed);
  }
  /* A card with no art yet: centre its text in the space the other cards take up. */
  .card.soon:not(:has(.art)) {
    justify-content: center;
    min-height: 360px;
  }
  .card.soon:hover {
    background: var(--panel);
  }
  /* A 2:1 strip: the GameCube case at full height on the left (about 0.7:1), and the title
     screen filling what's left, which comes out close to 4:3, the shape of the original screens. */
  .art {
    display: flex;
    aspect-ratio: 2 / 1;
    /* Without this the strip grows to the case image's natural height instead of staying 2:1. */
    min-height: 0;
    overflow: hidden;
    background: var(--night-deep);
  }
  .box {
    flex: none;
    height: 100%;
    width: auto;
    box-shadow: 6px 0 18px rgba(0, 0, 0, 0.5);
    position: relative;
  }
  .cover {
    flex: 1;
    min-width: 0;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .soon .body {
    padding: 36px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  h3 {
    margin: 0;
    font-size: 2rem;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 22px;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card-link:focus-visible::after {
    outline: 3px solid var(--lantern);
    outline-offset: -3px;
  }
  .more {
    margin-top: 6px;
    color: var(--lantern);
    font-weight: 700;
  }
  .soon .more {
    color: var(--moon);
    font-weight: 600;
  }
  .soon:hover .more {
    color: var(--lantern);
  }
</style>
